---
layout: layouts/base.njk
navKey: news
---
<section class="page-head">
  <h1 class="title title-md">{{ title | safe }}</h1>
</section>
<div class="article-meta caps">
  <span><time datetime="{{ page.date | isoDate }}">{{ page.date | monthYear }}</time></span>
  {% if tag %}<span>{{ tag }}</span>{% endif %}
</div>
{% if cover %}<figure class="p-cover contain"><img src="{{ cover }}" alt=""></figure>{% endif %}
<div class="p-body">
  <h2>News</h2>
  <div class="prose">{{ content | safe }}</div>
</div>
{%- set prev = collections.news | getPreviousCollectionItem(page) %}
{%- set next = collections.news | getNextCollectionItem(page) %}
{% if prev or next %}
<nav class="pager caps" aria-label="More news">
  {% if prev %}<a href="{{ prev.url }}"><span>← Newer</span><span>{{ prev.data.title }}</span></a>{% else %}<span></span>{% endif %}
  {% if next %}<a href="{{ next.url }}"><span>Older →</span><span>{{ next.data.title }}</span></a>{% endif %}
</nav>
{% endif %}
